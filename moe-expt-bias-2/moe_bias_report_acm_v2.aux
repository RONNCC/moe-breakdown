\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Full measurement table. MoE rows: v1 captures from \texttt  {s03\_h1\_verdict.json} ladder and \texttt  {s04\_bootstrap\_cis.json} v1 model blocks (CI bounds quoted verbatim from the \texttt  {entropy}/\texttt  {gini} arrays); drift columns are the v0$\rightarrow $v1 absolute drifts from \texttt  {stats\_analysis/outputs/s01\_exp1\_stability.json} (\texttt  {abs\_dH}/\texttt  {abs\_dG}). Dense rows: v1 per-pair captures from the \texttt  {exp2-*-v1} runs as reported in Table\nonbreakingspace \ref {tab:dense}; CIs come from the same \texttt  {s04\_bootstrap\_cis.json} block bootstrap as the MoE ladder (no drift column: dense runs were not captured twice at different pair counts, so there is no v0$\rightarrow $v1 comparison to report). Exp\nonbreakingspace 5 row: pooled OLMoE concentration from \texttt  {exp5-demographic-specificity-olmoe-1b-7b-v1/result.json} (it is not among the s04 bootstrap blocks, so its CI cells are marked `---'). $^{\ddagger }$Gemma-4-26B is a null-bias model (mean bias gap $\approx 0$); see Section\nonbreakingspace \ref {sec:limits}. $^{*}$Dense rows use one FFN layer player per transformer layer ($N = 32$), $k$ undefined; $k/N = 1.0$ as in the dense-group row of Table\nonbreakingspace \ref {tab:ladder}.}}{10}{table.caption.20}\protected@file@percent }
\newlabel{tab:appendix-full}{{4}{10}{Full measurement table. MoE rows: v1 captures from \texttt {s03\_h1\_verdict.json} ladder and \texttt {s04\_bootstrap\_cis.json} v1 model blocks (CI bounds quoted verbatim from the \texttt {entropy}/\texttt {gini} arrays); drift columns are the v0$\rightarrow $v1 absolute drifts from \texttt {stats\_analysis/outputs/s01\_exp1\_stability.json} (\texttt {abs\_dH}/\texttt {abs\_dG}). Dense rows: v1 per-pair captures from the \texttt {exp2-*-v1} runs as reported in Table~\ref {tab:dense}; CIs come from the same \texttt {s04\_bootstrap\_cis.json} block bootstrap as the MoE ladder (no drift column: dense runs were not captured twice at different pair counts, so there is no v0$\rightarrow $v1 comparison to report). Exp~5 row: pooled OLMoE concentration from \texttt {exp5-demographic-specificity-olmoe-1b-7b-v1/result.json} (it is not among the s04 bootstrap blocks, so its CI cells are marked `---'). $^{\ddagger }$Gemma-4-26B is a null-bias model (mean bias gap $\approx 0$); see Section~\ref {sec:limits}. $^{*}$Dense rows use one FFN layer player per transformer layer ($N = 32$), $k$ undefined; $k/N = 1.0$ as in the dense-group row of Table~\ref {tab:ladder}}{table.caption.20}{}}
